<!--
  Device-test APK only (never shipped): the test app must have no network permission. The test app is the
  highest-priority manifest, so these unscoped removals apply to every library in the test APK; this is the same
  app-side recipe the Android integration guide gives to apps that must have no network permission. ONNX Runtime's
  telemetry provider is removed by the library manifest itself, so this test APK also exercises that removal.
  DeviceTestFilesProvider: a private (not exported) provider of files in the test app's own storage, for the
  content-URI tests of file mode; the device tests never read or write the phone's shared storage.
  PlanMaskerProcessProvider and OrtControlProcessProvider: private providers in processes of their own, so that
  PlanMaskerDeviceTest can check which ONNX Runtime classes and libraries a process has loaded.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <application>
        <provider
            android:name="io.github.shishark.faceblur.android.DeviceTestFilesProvider"
            android:authorities="io.github.shishark.faceblur.test.files"
            android:exported="false" />
        <provider
            android:name="io.github.shishark.faceblur.android.PlanMaskerProcessProvider"
            android:authorities="io.github.shishark.faceblur.test.planmasker"
            android:exported="false"
            android:process=":planmasker" />
        <provider
            android:name="io.github.shishark.faceblur.android.OrtControlProcessProvider"
            android:authorities="io.github.shishark.faceblur.test.ortcontrol"
            android:exported="false"
            android:process=":ortcontrol" />
    </application>

</manifest>
