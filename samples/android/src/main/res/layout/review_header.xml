<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/Heading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:text="@string/review_heading" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="300dp">

        <ImageView
            android:id="@+id/preview"
            android:contentDescription="@string/preview_placeholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter" />

        <io.github.shishark.faceblur.sample.OverlayView
            android:id="@+id/overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <TextView
        android:id="@+id/counts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/scores"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:text="@string/review_note" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:text="@string/limits_copy" />

    <TextView
        android:id="@+id/no_masks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:text="@string/no_masks"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/review_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <Button
            android:id="@+id/add_mask"
            style="@style/Action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_mask" />

        <Button
            android:id="@+id/undo"
            style="@style/Action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/undo" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/placing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            style="@style/Heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/placing_heading" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2">

            <Button
                android:id="@+id/move_left"
                style="@style/Action"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="@string/move_left" />

            <Button
                android:id="@+id/move_right"
                style="@style/Action"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="@string/move_right" />

            <Button
                android:id="@+id/move_up"
                style="@style/Action"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="@string/move_up" />

            <Button
                android:id="@+id/move_down"
                style="@style/Action"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="@string/move_down" />

            <Button
                android:id="@+id/smaller"
                style="@style/Action"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="@string/smaller" />

            <Button
                android:id="@+id/larger"
                style="@style/Action"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="@string/larger" />
        </GridLayout>

        <Button
            android:id="@+id/place_mask"
            style="@style/Action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/place_mask" />

        <Button
            android:id="@+id/cancel_placing"
            style="@style/Action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel_placing" />
    </LinearLayout>
</LinearLayout>
